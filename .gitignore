# =====================================================================
# RL-Drive .gitignore
# Principle: track code + docs only. All runtime artifacts live outside
# git (workspace-mounted), not committed.
# =====================================================================

# ---------- machine-local env config ----------
# env.example.sh is tracked as the template; the filled-in copy holds
# machine-specific absolute paths and must not be committed.
env.sh

# ---------- data / models / checkpoints (NEVER commit) ----------
data/**
!data/.gitkeep
!data/README.md

models/
ckpt/
checkpoints/
pretrained/
*.pkl
*.pth
*.pt
*.bin
*.safetensors
*.ckpt
*.npy
*.npz

# ---------- EXCEPTION: published experiment artifacts ----------
# Small, load-bearing outputs that must survive node reclamation: the v11
# mining deltas (2.6 GPU-hours, reused by the next cycle) and the per-scene
# eval CSVs that the reported PDMS numbers are computed from.
!artifacts/
!artifacts/**

# ---------- EXCEPTION: our own trained scorer weights (release artifacts) ----------
# The token scorer + budget head is a 0.6M-param MLP: ~6.6MB per checkpoint.
# These are OUR training products and are small enough to ship in-repo so that
# `git clone` yields a directly usable model. Only the FINAL checkpoint of each
# published arm is tracked (intermediate ckpt_step*/ckpt_best stay ignored).
# Third-party pretrained backbones (AutoVLA / Qwen / ImpromptuVLA, 140GB) are
# NOT redistributed here — download them from their official sources.
!release_ckpt/
!release_ckpt/**

# ---------- experiment / log / result outputs ----------
exp/**
!exp/.gitkeep
!exp/README.md

logs/**
!logs/.gitkeep
!logs/README.md

results/**
!results/.gitkeep
!results/README.md

wandb/
mlruns/
tb_logs/
tensorboard/
outputs/
*.log
*.out
*.err
core.*
slurm-*.out

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg
pip-wheel-metadata/

# virtual envs (envs/ lives in workspace root, not repo, but be safe)
.venv/
venv/
env/
ENV/

# testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# type checking
.mypy_cache/
.pyre/
.dmypy.json
.ruff_cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_metadata
profile_default/
ipython_config.py

# ---------- IDE / editor ----------
.vscode/
.idea/
.cursor/
.codebuddy/
*.swp
*.swo
*~
.project
.pydevproject

# ---------- OS junk ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- secrets ----------
.env
.env.*
!.env.example
*.secret
secrets/
credentials.json
api_key*
*.pem

# ---------- HuggingFace cache (in case user mis-points) ----------
.cache/
huggingface/
transformers_cache/

# deprecated early-draft milestones (kept on disk for history, not pushed)
docs/plan/milestones.md

# internal analysis docs — now tracked
# docs/_internal/

# ---------- third-party / vendored repos ----------
# Track our patches/configs in third_party, but exclude .git and large binaries
code/third_party/**/.git/
code/third_party/**/codebook_cache/*.pkl
code/third_party/ImpromptuVLA/

# ---------- scripts: track all ----------
# (absolute paths are fine, this is a private research repo)

# ---------- local artifacts (do not commit) ----------
backups/
results/raw/
results/profiling/
STOP_*
landscape_queue.txt
*.zip
